{
  "name": "mbws-quote-tool",
  "version": "0.1.0",
  "private": true,
  "description": "Công cụ báo giá website: khảo sát web mẫu, chuẩn hóa yêu cầu, dự toán và báo giá theo gói Mắt Bão WS",
  "type": "module",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "start": "node --disable-warning=ExperimentalWarning server/index.js",
    "dev": "node --disable-warning=ExperimentalWarning --watch server/index.js",
    "sync:packages": "node --disable-warning=ExperimentalWarning scripts/sync-packages.js",
    "setup": "npx playwright install chromium",
    "eval:scan": "node --disable-warning=ExperimentalWarning scripts/eval-scan.js",
    "test": "node --disable-warning=ExperimentalWarning --test \"test/**/*.test.js\""
  },
  "dependencies": {
    "@anthropic-ai/sdk": "1.5.0",
    "@sparticuz/chromium": "141.0.0",
    "@vercel/functions": "3.11.0",
    "express": "4.21.2",
    "pg": "8.23.1",
    "playwright-core": "1.56.1"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.15",
    "playwright": "1.56.1"
  }
}
