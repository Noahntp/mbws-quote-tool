{
  "version": 2,
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api" },
    { "source": "/quote/(.*)", "destination": "/api" },
    { "source": "/storage/(.*)", "destination": "/api" },
    { "source": "/auth/(.*)", "destination": "/api" }
  ],
  "functions": {
    "api/index.js": {
      "includeFiles": "{data/**,server/**,node_modules/@sparticuz/chromium/bin/**}",
      "maxDuration": 300
    }
  }
}
